digraph SideChartDatabase {
    graph [
        rankdir=TB,
        bgcolor="#ffffff",
        nodesep=0.55,
        ranksep=0.85,
        pad=0.25,
        splines=ortho,
        fontname="Helvetica"
    ];
    node [shape=plain, fontname="Helvetica"];
    edge [
        color="#64748b",
        fontcolor="#334155",
        fontname="Helvetica",
        fontsize=10,
        penwidth=1.5,
        arrowsize=0.8
    ];

    research_signals [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2563eb">
            <TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>research_signals</B></FONT></TD></TR>
            <TR><TD PORT="id" ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">ticker</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">signal_type</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">suggested_price</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">confidence_score</TD><TD ALIGN="LEFT">NUMERIC(6,5)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">analysis_metadata</TD><TD ALIGN="LEFT">JSONB</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    supervisor_reviews [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#d97706">
            <TR><TD COLSPAN="3" BGCOLOR="#d97706"><FONT COLOR="white"><B>supervisor_reviews</B></FONT></TD></TR>
            <TR><TD PORT="id" ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD PORT="signal_id" ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">signal_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">adjusted_quantity</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">adjusted_limit_price</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">reviewer_notes</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">reviewed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    orders [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#059669">
            <TR><TD COLSPAN="3" BGCOLOR="#059669"><FONT COLOR="white"><B>orders</B></FONT></TD></TR>
            <TR><TD PORT="id" ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD PORT="supervisor_review_id" ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">supervisor_review_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">ib_order_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">ib_perm_id</TD><TD ALIGN="LEFT">INTEGER (unique)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">VARCHAR(4)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">order_type</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">total_qty</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">filled_qty</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    executions [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#059669">
            <TR><TD COLSPAN="3" BGCOLOR="#059669"><FONT COLOR="white"><B>executions</B></FONT></TD></TR>
            <TR><TD PORT="id" ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD PORT="order_id" ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">ib_exec_id</TD><TD ALIGN="LEFT">VARCHAR(100) (unique)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">shares</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">commission</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">executed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    portfolio_positions [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c3aed">
            <TR><TD COLSPAN="3" BGCOLOR="#7c3aed"><FONT COLOR="white"><B>portfolio_positions</B></FONT></TD></TR>
            <TR><TD PORT="ticker" ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>ticker</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">position_size</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">average_cost</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">market_value</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">unrealized_pnl</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        </TABLE>
    >];

    agent_tokens_audit [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#7c3aed">
            <TR><TD COLSPAN="3" BGCOLOR="#7c3aed"><FONT COLOR="white"><B>agent_tokens_audit</B></FONT></TD></TR>
            <TR><TD PORT="id" ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">UUID</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">agent_name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
            <TR><TD PORT="signal_id" ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">signal_id</TD><TD ALIGN="LEFT">UUID (nullable)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">prompt_tokens</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">completion_tokens</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">cost</TD><TD ALIGN="LEFT">NUMERIC(20,8)</TD></TR>
        </TABLE>
    >];

    research_signals:s -> supervisor_reviews:n [xlabel="1 to 0..*", arrowhead=crow];
    supervisor_reviews:s -> orders:n [xlabel="1 to 0..*", arrowhead=crow];
    orders:s -> executions:n [xlabel="1 to 0..*", arrowhead=crow];
    research_signals:e -> agent_tokens_audit:n [xlabel="0..1 to 0..*", arrowhead=crow, style=dashed];

    {rank=same; supervisor_reviews; agent_tokens_audit;}
    {rank=same; executions; portfolio_positions;}
}
