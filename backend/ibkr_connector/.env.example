AWS_REGION=us-east-1
# For local development, an AWS SSO profile can be used. Production should use
# IAM Roles Anywhere through credential_process instead of permanent keys.
AWS_PROFILE=sidechart

IBKR_COMMAND_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/sidechart-ibkr-commands.fifo
IBKR_EVENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/sidechart-ibkr-events.fifo
IBKR_CONNECTOR_ID=sidechart-mac
IBKR_ACCOUNT_MODE=PAPER
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=31
IBKR_MAX_ORDER_QUANTITY=1000
IBKR_HEARTBEAT_SECONDS=30
IBKR_JOURNAL_PATH=.sidechart/ibkr_connector.sqlite3
IBKR_KILL_SWITCH_PATH=.sidechart/IBKR_KILL_SWITCH

# Never enable this until paper trading and failure recovery have been tested.
IBKR_ALLOW_LIVE_TRADING=false
